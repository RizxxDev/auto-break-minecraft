{
  "name": "autonomous-quarry-bot",
  "version": "1.0.0",
  "description": "Autonomous underground quarry bot built with Mineflayer and TypeScript.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mineflayer",
    "minecraft",
    "quarry",
    "bot"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "mineflayer": "^4.27.0",
    "mineflayer-collectblock": "^1.5.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-block": "^1.21.0",
    "prismarine-item": "^1.15.0",
    "vec3": "^0.1.10",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
